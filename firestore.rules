rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /scores/{uid} {
      allow read, write: if owner(uid);
    }
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['displayName', 'score', 'highScore', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'score', 'highScore', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName == request.auth.token.email.split('@')[0]
        && request.resource.data.score is int && request.resource.data.score >= 0
        && request.resource.data.highScore is int
        && request.resource.data.highScore >= request.resource.data.score
        && request.resource.data.score == getAfter(/databases/$(database)/documents/scores/$(uid)).data.score
        && request.resource.data.highScore == getAfter(/databases/$(database)/documents/scores/$(uid)).data.highScore
        && request.resource.data.updatedAt is timestamp
        && (request.resource.data.updatedAt == request.time
          || (resource != null && request.resource.data.updatedAt == resource.data.updatedAt));
      allow delete: if owner(uid);
    }
  }
}
